# Database Configuration
REMOTE_HOST=your_remote_host_url
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database
REMOTE_PORT=3306

# SQL query for fetching video URLs
DB_SELECT_QUERY=SELECT CONCAT('https://.../', content_url) AS full_url FROM course_lessons WHERE course_content_type_id = 1 AND content_url IS NOT NULL AND original_content_url IS NOT NULL AND deleted_at IS NULL AND content_url LIKE '%.mp4%' ORDER BY created_at DESC


# File Paths
MAIN_CSV_PATH=/path/to/pymp4hls/mp4hls-videos.csv
URLS_DIR=/path/to/pymp4hls/urls
INPUT_FOLDER=/path/to/pymp4hls/videos/input
OUTPUT_FOLDER=/path/to/pymp4hls/videos/output
UPLOADS_DIR=/path/to/pymp4hls/uploads
LOGS_DIR=/Users/g.e.bayualfian/Documents/GitHub/pymp4hls/logs

# S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_REGION=ap-southeast-1
S3_PREFIX=hls/
SSH_USER=ssh-user
SSH_HOST=ip-address
SSH_KEY_PATH=key.pem

# Application Settings
RESOLUTIONS=1080,720,480,360,240
CONVERTER_CHECK_INTERVAL=60
DOWNLOADER_CHECK_INTERVAL=60
DOWNLOADER_LONG_INTERVAL=300
CHECK_INTERVAL=300